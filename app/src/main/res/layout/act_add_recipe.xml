<?xml version="1.0" encoding="utf-8"?>

<!-- Scroll wheel allowing contents to fit on one page -->
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true"
    tools:context=".act_add_recipe">

    <!-- controls for recipe page -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="25dp">

        <!-- Page heading -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Add Recipe"
            android:textColor="#000000"
            android:textSize="28sp"
            android:textStyle="bold" />

        <!-- Recipe label -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:text="Recipe Name"
            android:textColor="#000000"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!--Entering the recipe name -->
        <EditText
            android:id="@+id/editRecipeName"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="8dp"
            android:hint="Example: Chicken Curry"
            android:inputType="textCapWords"
            android:padding="12dp"
            android:textColor="#000000"
            android:textColorHint="#777777" />

        <!-- Ingredients heading -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:text="Ingredients"
            android:textColor="#000000"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Showing ingredient format -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Enter each ingredient below and select Add Ingredient"
            android:textColor="#666666"
            android:textSize="13sp" />

        <!-- Entering ingredient name -->
        <EditText
            android:id="@+id/editIngredientName"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="12dp"
            android:hint="Ingredient Name"
            android:inputType="textCapWords"
            android:padding="12dp"
            android:textColor="#000000"
            android:textColorHint="#777777" />

        <!-- Entering ingredient quantity -->
        <EditText
            android:id="@+id/editIngredientQuantity"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="8dp"
            android:hint="Quantity"
            android:inputType="numberDecimal"
            android:padding="12dp"
            android:textColor="#000000"
            android:textColorHint="#777777" />

        <!-- Entering ingredient unit -->
        <EditText
            android:id="@+id/editIngredientUnit"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="8dp"
            android:hint="Unit example kg or ml"
            android:inputType="text"
            android:padding="12dp"
            android:textColor="#000000"
            android:textColorHint="#777777" />

        <!-- Add ingredient to recipe -->
        <Button
            android:id="@+id/btnAddRecipeIngredient"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="#6D4C41"
            android:text="Add Ingredient"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <!-- Added ingredients heading -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Added Ingredients"
            android:textColor="#000000"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Shows ingredients added to recipe -->
        <TextView
            android:id="@+id/txtAddedIngredients"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#F5F5F5"
            android:minHeight="80dp"
            android:padding="12dp"
            android:text="No ingredients added yet"
            android:textColor="#666666"
            android:textSize="14sp" />

        <!-- Cooking steps heading -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:text="Cooking Steps"
            android:textColor="#000000"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!--entering the cooking method-->
        <EditText
            android:id="@+id/editRecipeMethod"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_marginTop="8dp"
            android:gravity="top|start"
            android:hint="1. Prepare the ingredients.&#10;2. Cook the ingredients.&#10;3. Add the vegetables.&#10;4. Serve."
            android:inputType="textMultiLine"
            android:padding="12dp"
            android:textColor="#000000"
            android:textColorHint="#777777" />

        <!--Save recipe button-->
        <Button
            android:id="@+id/btnSaveRecipe"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="25dp"
            android:backgroundTint="#6D4C41"
            android:text="Save Recipe"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <!--Adding canceling button-->
        <Button
            android:id="@+id/btnCancelRecipe"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="30dp"
            android:backgroundTint="#9E9E9E"
            android:text="Cancel"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>