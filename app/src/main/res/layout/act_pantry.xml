<?xml version="1.0" encoding="utf-8"?>

<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".PantryAct">

    <!-- Main pantry screen -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F8F8F8">

        <!-- Top toolbar -->
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/pantryToolbar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="?attr/actionBarSize"
            android:background="#FFFFFF"
            app:title="My Pantry"
            app:titleCentered="true"
            app:titleTextColor="#000000"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- pantry list -->
        <ListView
            android:id="@+id/listPantry"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="15dp"
            android:layout_marginTop="15dp"
            android:layout_marginEnd="15dp"
            android:divider="@android:color/transparent"
            android:dividerHeight="10dp"
            app:layout_constraintBottom_toTopOf="@+id/btnAddIngredient"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/pantryToolbar" />

        <!-- empty pantry message -->
        <TextView
            android:id="@+id/txtEmptyPantry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Your pantry is empty. Add an ingredient."
            android:textColor="#666666"
            android:textSize="16sp"
            app:layout_constraintBottom_toBottomOf="@+id/listPantry"
            app:layout_constraintEnd_toEndOf="@+id/listPantry"
            app:layout_constraintStart_toStartOf="@+id/listPantry"
            app:layout_constraintTop_toTopOf="@+id/listPantry" />

        <!-- Adding ingredient button -->
        <Button
            android:id="@+id/btnAddIngredient"
            android:layout_width="0dp"
            android:layout_height="55dp"
            android:layout_marginStart="30dp"
            android:layout_marginEnd="30dp"
            android:layout_marginBottom="20dp"
            android:text="Add Ingredient"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            app:backgroundTint="#6D4C41"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Hamburger Navig heading -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigationView"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="#FFFFFF"
        app:headerLayout="@layout/nav_ham"
        app:menu="@menu/hamburger_menu" />

</androidx.drawerlayout.widget.DrawerLayout>